  "milestones": [
    {
      "id": "M0",
      "title": "M0 - Foundation",
      "description": "Reproducible local development, contributor conventions, native CI, and a reviewed threat model. No public release."
    },
    {
      "id": "M1",
      "title": "M1 - Library MVP",
      "description": "A reusable Rust library with three evidence-backed core targets, read-only planning, safe copy execution, tests, and consumer examples."
    },
    {
      "id": "M2",
      "title": "M2 - CLI MVP",
      "description": "A thin non-interactive CLI and an optional interactive selection flow, both using the library."
    },
    {
      "id": "M3",
      "title": "M3 - Verified catalog expansion",
      "description": "Parallel research and tested adapters for additional hosts. Candidate count is not a support claim or a release gate."
    },
    {
      "id": "M4",
      "title": "M4 - OSS and release readiness",
      "description": "Security checks, packaging rehearsals, distribution plans, and explicit human approval before visibility or publishing changes."
    },
    {
      "id": "M5",
      "title": "M5 - Post-MVP",
      "description": "Explicitly deferred: symbolic links, remote acquisition, and managed updates/uninstall. Do not implement as incidental MVP scope."
    }
